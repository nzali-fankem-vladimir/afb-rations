# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node / Frontend
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# Fichiers d'environnement (secrets, jamais versionnes)
.env
.env.*
!.env.example
*.env.local

# IDE
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project
.factorypath

# Systeme d'exploitation
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Documents internes de preparation (non destines au depot public)
docs/initialisation projet/
sprint actuel.md
# Sortie generee par la cartographie graphify (non versionnee)
graphify-out/

# Pieces jointes produites a l'execution (PDF des etats mensuels, Sprint 4.2).
# Ce sont des donnees, pas du code : le repertoire est recree au demarrage et son
# contenu depend de la base locale.
backend/*/donnees/
