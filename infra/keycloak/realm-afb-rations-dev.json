{
  "realm": "afb-rations-dev",
  "displayName": "AFB Rations et Transport Garde Armee (developpement)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 28800,
  "roles": {
    "realm": [
      {
        "name": "AGENT_UNITE",
        "description": "Agent d'unite - saisie journaliere et soumission"
      },
      {
        "name": "CHEF_UNITE_DA",
        "description": "Chef d'unite - premier niveau de validation"
      },
      {
        "name": "DIRECTEUR_RESEAU_DR",
        "description": "Directeur reseau - validation au-dela du seuil d'aiguillage"
      },
      {
        "name": "ARH",
        "description": "Analyste ressources humaines - creation des grilles tarifaires"
      },
      {
        "name": "DRH",
        "description": "Directeur des ressources humaines - validation des grilles tarifaires"
      },
      {
        "name": "ADMIN",
        "description": "Administrateur du module rations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rations-frontend",
      "name": "Frontend React du module rations",
      "description": "Client public, authorization code + PKCE S256. Aucun secret : le code est telecharge par le navigateur.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-rations-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rations-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "matricule",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "matricule",
            "claim.name": "matricule",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
