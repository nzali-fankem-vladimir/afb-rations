# Variables de la composition Docker (Sprint 8.2).
#
# Copier ce fichier en ".env" (meme dossier) pour changer une valeur. Le fichier
# .env n'est JAMAIS versionne (.gitignore) : c'est lui qui portera les vraies
# valeurs. Ce modele ne contient AUCUNE valeur sensible : les mots de passe sont
# des garde-fous de developpement, a remplacer hors du poste du developpeur.
#
# Toute variable absente prend la valeur de repli ecrite dans
# docker-compose.yml ; il n'est donc pas obligatoire de creer un .env pour
# lancer la composition en local.

# --- Secrets (repli : changeme-in-development) -------------------------------

# Superutilisateur PostgreSQL.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme-in-development

# Mot de passe des cinq roles applicatifs (un role et une base par service).
# Lu par le script d'initialisation de PostgreSQL au PREMIER demarrage du
# volume seulement : le changer ensuite sur un volume existant ne change pas
# le mot de passe deja enregistre dans la base.
RATIONS_DB_PASSWORD=changeme-in-development

# Secret partage entre le service Workflow et le service Transmission
# (endpoint interne PUT /processus/{id}/integration, dispositif provisoire :
# docs/dispositifs_provisoires.md section 3bis). Les DEUX services doivent
# recevoir la meme valeur : c'est pourquoi une seule variable les alimente.
INTEGRATION_CLE_INTERNE=changeme-in-development

# --- Versions des images ------------------------------------------------------

# Etiquette des images construites (rations-identite:<IMAGE_TAG>...).
# Convention d'etiquetage et publication sur Harbor : docs/publication-images.md.
IMAGE_TAG=latest

# --- Keycloak (fourni par la composition) -------------------------------------

# La composition demarre SON PROPRE Keycloak, realm importe automatiquement :
# rien a installer. Il n'a aucun lien avec celui du projet DOTTEL.
#
# Port de Keycloak sur le poste. 8180 par defaut. Si le port est deja pris (le
# Keycloak de DOTTEL l'occupe), mettre 8181 : l'emetteur des jetons et l'adresse
# donnee au frontend s'en deduisent, il n'y a rien d'autre a changer.
KEYCLOAK_PORT=8180
# Mot de passe de la console d'administration de Keycloak (compte "admin").
KEYCLOAK_ADMIN_PASSWORD=changeme-in-development

# Reglages avances : ne les renseigner que pour pointer vers un Keycloak
# EXTERNE (recette, production). Par defaut ils se deduisent de KEYCLOAK_PORT.
# Emetteur attendu dans le jeton (claim "iss") : l'adresse que voit le NAVIGATEUR.
# KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/afb-rations-dev
# KEYCLOAK_AUDIENCE=rations-api
# Adresse des cles de signature, atteinte DEPUIS un conteneur (localhost, dans
# un conteneur, est le conteneur lui-meme). Par defaut : keycloak:8080.
# KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/afb-rations-dev/protocol/openid-connect/certs

# --- Registre et routage ------------------------------------------------------

# true : les services s'enregistrent, la passerelle route par nom (lb://).
# false : aucun enregistrement ; renseigner alors les sept GATEWAY_*_URI
# ci-dessous en adresses fixes.
EUREKA_ENABLED=true
# GATEWAY_IDENTITE_URI=http://service-identite:8081
# GATEWAY_SAISIE_URI=http://service-saisie:8082
# GATEWAY_GRILLES_URI=http://service-grilles:8083
# GATEWAY_WORKFLOW_URI=http://service-workflow:8084
# GATEWAY_REPORTING_URI=http://service-reporting:8085
# GATEWAY_TRANSMISSION_URI=http://service-transmission:8086
# GATEWAY_AUDIT_URI=http://service-audit:8087

# Origine du navigateur autorisee par le CORS de la passerelle. Doit etre
# l'adresse EXACTE du frontend, port compris (5173, fige dans les URI de
# redirection du realm).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (ecrites dans /config.js au demarrage du conteneur) -------------

# Port de la passerelle sur le poste. 8080 par defaut. Si ce port est deja pris
# (l'application DOTTEL l'occupe), mettre 8090 : l'adresse donnee au frontend
# s'en deduit, rien d'autre a changer. Sans cela, la passerelle et le frontend
# ne demarrent pas.
GATEWAY_PORT=8080

# Adresses vues depuis le NAVIGATEUR, pas depuis un conteneur. Aucun secret :
# tout navigateur qui charge la page peut les lire. Les adresses de la passerelle
# et de Keycloak se deduisent de GATEWAY_PORT et KEYCLOAK_PORT ; ne les renseigner
# que pour un environnement externe.
# FRONTEND_API_BASE_URL=http://localhost:8080/api
# FRONTEND_KEYCLOAK_URL=http://localhost:8180
FRONTEND_KEYCLOAK_REALM=afb-rations-dev
FRONTEND_KEYCLOAK_CLIENT_ID=rations-frontend
