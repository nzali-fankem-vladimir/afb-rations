<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cm.afrilandfirstbank.rations</groupId>
        <artifactId>rations-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>service-workflow</artifactId>
    <packaging>jar</packaging>

    <name>service-workflow</name>
    <description>Workflow et validation - processus mensuel, etapes, aiguillage au seuil, cloture</description>

    <dependencies>
        <!-- Publication des evenements d'audit sur rations.audit.evenement.
             Bibliotheque partagee par les six services metier (decision Sprint
             1.3) : le producteur, avec ses cinq couches de protection, vit a un
             seul endroit. N'est PAS une dependance vers le service Audit, qui
             reste joignable uniquement par le topic. Ne jamais reecrire un
             producteur local ni surcharger max.block.ms (CLAUDE.md section 15). -->
        <dependency>
            <groupId>cm.afrilandfirstbank.rations</groupId>
            <artifactId>rations-audit-commun</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring Boot 4 : l'auto-configuration Flyway vit dans ce starter.
             flyway-core seul n'active aucune migration au demarrage. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- Generation du document mensuel (RG-09, Sprint 4.2). iText 8 se
             declare par ses deux artefacts kernel et layout : itext-core est un
             agregat, pas une dependance directe (decision Sprint 0.2,
             CLAUDE.md section 17). Les versions viennent du dependencyManagement
             du pom parent.

             kernel : le document PDF lui-meme, l'ecriture et surtout la RELECTURE
                      (PdfReader) dont dependra l'enrichissement du document par
                      les signatures des sous-sprints 4.3 et 4.4.
             layout : la mise en page de haut niveau (paragraphes, tableaux,
                      canevas positionnes) qui porte la charte section 8.2. -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>layout</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 : la tranche @WebMvcTest vit dans son propre starter.
             Requise par ProcessusControllerIT, qui traverse la chaine
             jeton -> securite -> controleur. Memes dependances qu'ont ajoutees
             service-grilles (Sprint 2.2) puis service-saisie (Sprint 3.3). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Utilitaires de test de Spring Security. Sans elle, la tranche
             @WebMvcTest monte sans filtre de securite et tout endpoint
             repondrait 200 : les tests de 401 et de 403 passeraient a cote de
             ce qu'ils pretendent verifier. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 a scinde les tranches de test : @DataJpaTest et
             @AutoConfigureTestDatabase vivent dans ce starter dedie, pas dans
             spring-boot-starter-test. Requis par ProcessusServiceTest, qui
             tourne contre la vraie base rations_workflow (decision Sprint 2.1,
             docs/decisions/2026-08-27-tests-repository-et-validation-schema.md). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
