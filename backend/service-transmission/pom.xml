<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cm.afrilandfirstbank.rations</groupId>
        <artifactId>rations-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>service-transmission</artifactId>
    <packaging>jar</packaging>

    <name>service-transmission</name>
    <description>Transmission comptable - publie l'etat valide, consomme l'accuse comptable (pas de base propre)</description>

    <dependencies>
        <!-- Publication des evenements d'audit sur rations.audit.evenement.
             Bibliotheque partagee par les six services metier (decision Sprint
             1.3) : le producteur, avec ses cinq couches de protection, vit a un
             seul endroit. N'est PAS une dependance vers le service Audit, qui
             reste joignable uniquement par le topic. Ne jamais reecrire un
             producteur local ni surcharger max.block.ms (CLAUDE.md section 15).

             PROPRE A CE SERVICE : il porte son PROPRE KafkaTemplate pour
             rations.etat.valide. Celui de l'audit est un bean distinct, qualifie
             kafkaTemplateAudit (AuditCommunAutoConfiguration). Injecter le
             mauvais publierait les evenements d'audit sur le topic comptable. -->
        <dependency>
            <groupId>cm.afrilandfirstbank.rations</groupId>
            <artifactId>rations-audit-commun</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
