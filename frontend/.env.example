# URL de base de l'API.
# En attendant le routage de la passerelle (sprint 0.8), les appels vont
# directement au service Identite. A repointer sur http://localhost:8080/api
# des que la passerelle expose ses routes.
VITE_API_BASE_URL=http://localhost:8081

# Fournisseur d'identite. Aucun secret ici : le client est public,
# l'authentification se fait en authorization code avec PKCE (CLAUDE.md section 10).
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=afb-rations-dev
VITE_KEYCLOAK_CLIENT_ID=rations-frontend
