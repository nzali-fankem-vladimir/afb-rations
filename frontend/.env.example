# URL de base de l'API : la PASSERELLE, prefixe /api compris.
# Elle est la seule adresse de backend que le frontend connaisse depuis le
# Sprint 8.1. Les six variables par service (VITE_API_SAISIE_URL et les
# autres, Sprint 7F.4) ont disparu : en production, seule la passerelle est
# exposee, et un appel direct a un service fonctionnerait en developpement
# pour echouer une fois deploye.
VITE_API_BASE_URL=http://localhost:8080/api

# Fournisseur d'identite. Aucun secret ici : le client est public,
# l'authentification se fait en authorization code avec PKCE (CLAUDE.md section 10).
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=afb-rations-dev
VITE_KEYCLOAK_CLIENT_ID=rations-frontend
