# URL de base de l'API, une par service backend.
# La passerelle (Spring Cloud Gateway) existe en code mais n'est pas encore
# deployee en local (sprint 0.8, toujours en attente) : chaque service est donc
# appele directement sur son propre port (arbitrage Sprint 7F.4). A repointer
# toutes les six vers la meme URL de passerelle des qu'elle route reellement.
VITE_API_BASE_URL=http://localhost:8081
VITE_API_SAISIE_URL=http://localhost:8082
VITE_API_GRILLES_URL=http://localhost:8083
VITE_API_WORKFLOW_URL=http://localhost:8084
VITE_API_REPORTING_URL=http://localhost:8085
VITE_API_AUDIT_URL=http://localhost:8087

# Fournisseur d'identite. Aucun secret ici : le client est public,
# l'authentification se fait en authorization code avec PKCE (CLAUDE.md section 10).
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=afb-rations-dev
VITE_KEYCLOAK_CLIENT_ID=rations-frontend
